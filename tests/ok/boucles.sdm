// while, for et ++
main() {
    int i = 0;
    int s = 0;
    while (i < 5) {
        s = s + i;
        i++;
    }
    print(s);                       // 0+1+2+3+4 = 10

    int j;
    int produit = 1;
    for (j = 1; j <= 5; j++;) {
        produit = produit * j;
    }
    print(produit);                 // 120

    int k;
    for (k = 3; k > 0; k = k - 1;) print(k);
}
